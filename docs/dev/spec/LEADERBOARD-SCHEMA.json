{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tetris leaderboard format version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "results"],
  "properties": {
    "formatVersion": { "type": "integer", "const": 1 },
    "results": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "timestamp"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
          "score": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "timestamp": { "type": "string", "minLength": 24, "maxLength": 24, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "format": "utc-timestamp" }
        }
      }
    }
  }
}
