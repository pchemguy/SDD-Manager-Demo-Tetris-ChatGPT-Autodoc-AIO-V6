{
  "name": "browser-tetris",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-schema.mjs && vite --host 127.0.0.1",
    "build": "node scripts/copy-schema.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node scripts/copy-schema.mjs && vitest run",
    "test:browser": "playwright test",
    "package": "npm run build && python scripts/package.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
