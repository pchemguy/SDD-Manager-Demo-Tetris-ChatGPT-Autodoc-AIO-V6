{
  "name": "browser-tetris",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-schema.mjs && vite --host 127.0.0.1",
    "build": "node scripts/copy-schema.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node scripts/copy-schema.mjs && vitest run",
    "test:browser": "playwright test",
    "test:dev": "playwright test --config=playwright.dev.config.ts",
    "package": "npm run build && python scripts/package.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/sql.js": "1.4.11",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "sql.js": "1.15.1"
  }
}
